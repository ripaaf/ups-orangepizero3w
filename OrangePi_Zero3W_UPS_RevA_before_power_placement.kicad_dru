(version 1)

# Fine-pitch QFN/TDFN packages need a local 0.15 mm escape clearance.
# This only relaxes copper clearance around U1/U2/U3; all other board areas
# continue to use their assigned netclass clearances.
(rule "Fine-pitch IC local clearance"
    (condition "A.memberOfFootprint('U1') || A.memberOfFootprint('U2') || A.memberOfFootprint('U3')")
    (constraint clearance (min 0.15mm)))

# The TPS61088 imported footprint uses 0.20 mm plated thermal-via drills in
# the exposed PGND pad. Keep the board-wide 0.30 mm drill rule elsewhere.
(rule "TPS61088 thermal-via drill"
    (condition "A.memberOfFootprint('U5') && A.Hole_Size_X == 0.20mm")
    (constraint hole_size (min 0.20mm)))

# The USB-C receptacle's mechanical/shield features intentionally sit close
# to the board edge. Keep the global 0.30 mm edge rule elsewhere.
(rule "USB-C connector local edge clearance"
    (condition "A.memberOfFootprint('J3')")
    (constraint edge_clearance (min 0.25mm)))

(rule "J3 USB-C internal pad clearance"
    (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3')")
    (constraint clearance (min 0.20mm))
)

(rule "U6 TPS25947 internal pad clearance"
    (condition "A.memberOfFootprint('U6') && B.memberOfFootprint('U6')")
    (constraint clearance (min 0.20mm))
)