  )
  (fp_text value "TPS259470ARPWR" (at 0 2.05) (layer F.Fab)
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )
  (fp_text user "%R" (at 0 0 90) (layer F.Fab)
    (effects (font (size 0.55 0.55) (thickness 0.08)))
  )
  (fp_line (start -1 -1) (end 1 -1) (layer F.Fab) (width 0.1))
  (fp_line (start 1 -1) (end 1 1) (layer F.Fab) (width 0.1))
  (fp_line (start 1 1) (end -1 1) (layer F.Fab) (width 0.1))
  (fp_line (start -1 1) (end -1 -1) (layer F.Fab) (width 0.1))
  (fp_line (start -1.05 -1.05) (end -0.55 -1.05) (layer F.SilkS) (width 0.12))
