(module "TPS259470ARPWR_RPW0010A" (layer F.Cu)
  (descr "Texas Instruments RPW0010A VQFN-HR-10, 2.0x2.0mm, 0.45mm pitch; corner terminals use duplicate same-number pad primitives to form the recommended L-shaped lands")
  (tags "TPS25947 RPW0010A VQFN-HR-10 eFuse")
