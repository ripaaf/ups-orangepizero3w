  (fp_line (start -1.05 1.05) (end -0.55 1.05) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.05 1.05) (end -1.05 0.55) (layer F.SilkS) (width 0.12))
  (fp_line (start 1.05 1.05) (end 0.55 1.05) (layer F.SilkS) (width 0.12))
  (fp_line (start 1.05 1.05) (end 1.05 0.55) (layer F.SilkS) (width 0.12))
  (fp_circle (center -1.35 -1.15) (end -1.25 -1.15) (layer F.SilkS) (width 0.12))
  (fp_line (start -1.45 -1.45) (end 1.45 -1.45) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.45 -1.45) (end 1.45 1.45) (layer F.CrtYd) (width 0.05))
  (fp_line (start 1.45 1.45) (end -1.45 1.45) (layer F.CrtYd) (width 0.05))
  (fp_line (start -1.45 1.45) (end -1.45 -1.45) (layer F.CrtYd) (width 0.05))
  (pad 1 smd rect (at -0.900 -0.700 90) (size 0.300 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 2 smd rect (at -0.900 -0.225 90) (size 0.250 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 3 smd rect (at -0.900 0.225 90) (size 0.250 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at -0.900 0.700 90) (size 0.300 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 5 smd rect (at -0.250 0 0) (size 0.300 2.400) (layers F.Cu F.Paste F.Mask))
  (pad 6 smd rect (at 0.250 0 0) (size 0.300 2.400) (layers F.Cu F.Paste F.Mask))
  (pad 7 smd rect (at 0.900 0.700 90) (size 0.300 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 8 smd rect (at 0.900 0.225 90) (size 0.250 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 9 smd rect (at 0.900 -0.225 90) (size 0.250 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 10 smd rect (at 0.900 -0.700 90) (size 0.300 0.600) (layers F.Cu F.Paste F.Mask))
  (pad 1 smd rect (at -0.725 -1.025 0) (size 0.250 0.350) (layers F.Cu F.Paste F.Mask))
  (pad 4 smd rect (at -0.725 1.025 0) (size 0.250 0.350) (layers F.Cu F.Paste F.Mask))
  (pad 7 smd rect (at 0.725 1.025 0) (size 0.250 0.350) (layers F.Cu F.Paste F.Mask))
  (pad 10 smd rect (at 0.725 -1.025 0) (size 0.250 0.350) (layers F.Cu F.Paste F.Mask))
  (model "${KIPRJMOD}/libraries/TPS25947_fixed.3dshapes/TPS259470ARPWR.stp"
